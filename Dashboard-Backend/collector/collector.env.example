# ---- Cloud Function endpoint + token ----
FUNC_URL=https://europe-west4-voip-server-493820.cloudfunctions.net/gatewayPush
PUSH_TOKEN=your-token-here

# ---- Asterisk CDR database (CDR mode) ----
# From /etc/freepbx.conf: AMPDBHOST / AMPDBUSER / AMPDBPASS. DB name is asteriskcdrdb.
DB_HOST=localhost
DB_USER=freepbxuser
DB_PASS=your-db-password
DB_NAME=asteriskcdrdb
STATE_FILE=/var/lib/sim-collector/cdr_state

# ---- Gateway (call-stat mode; needs the VPN route to the gateway) ----
SK_HOST=192.168.8.10
SK_PORT=80
SK_USER=gateway-admin-user
SK_PASS=gateway-admin-password
